{
    "compilerOptions": {
        "allowJs": false,
        "strict": true,
        "jsx": "react-jsx",
        "baseUrl": "./src",
        "target": "ES2020",
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["node", "vite/client"],
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": true,

    },
    "include": ["src"],
}